APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=motoboy
DB_USERNAME=motoboy
DB_PASSWORD=motoboy

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────── Prestataires — Tranzak et TechSoft ───────────────────
#
# **Aucune de ces variables n'est encore lue par du code.** Les adaptateurs
# n'existent pas : `payments.gateways` et `sms.drivers` ne connaissent que les
# pilotes factices. Elles sont déclarées ici pour que les identifiants soient
# demandés dès maintenant — un nom d'expéditeur SMS se fait enregistrer, et cela
# prend des jours.
#
# Les écrire n'active rien : tant que `PAYMENT_GATEWAY` vaut `fake`, le pilote
# factice reste en place. C'est voulu — on ne bascule qu'une fois l'adaptateur
# écrit et éprouvé contre l'environnement de test du prestataire.

# ── Tranzak — encaissement Mobile Money (MTN, Orange)
# Passer à `tranzak` le jour où l'adaptateur existe. Pas avant.
PAYMENT_GATEWAY=fake
TRANZAK_BASE_URL=
TRANZAK_APP_ID=
TRANZAK_APP_KEY=
# ⚠️ Le secret qui signe les webhooks. **Sans lui, n'importe qui peut déclarer
# un paiement réussi** : c'est la seule chose qui distingue Tranzak d'un
# inconnu qui connaît l'URL. La vérification doit échouer fermée.
TRANZAK_WEBHOOK_SECRET=

# ── Tranzak — décaissement vers les agences et les chauffeurs
# Port distinct de l'encaissement : un prestataire peut couvrir l'un sans
# l'autre. Même identifiants si c'est le même compte.
PAYOUT_GATEWAY=fake
# Le compte source des virements, à confirmer auprès de Tranzak.
TRANZAK_PAYOUT_ACCOUNT=

# ── TechSoft — SMS
# L'OTP est le seul canal sans alternative (I8) : une panne ici bloque toute
# inscription.
SMS_DRIVER=log
TECHSOFT_BASE_URL=
TECHSOFT_API_KEY=
# Le nom affiché à la réception. À faire enregistrer auprès de l'opérateur —
# c'est la démarche la plus longue de toute l'intégration.
TECHSOFT_SENDER_ID=
