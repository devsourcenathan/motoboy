APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=motoboy
DB_USERNAME=motoboy
DB_PASSWORD=motoboy

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────── Prestataires — Tranzak et TechSoft ───────────────────
#
# **Aucune de ces variables n'est encore lue par du code.** Les adaptateurs
# n'existent pas : `payments.gateways` et `sms.drivers` ne connaissent que les
# pilotes factices. Elles sont déclarées ici pour que les identifiants soient
# demandés dès maintenant — un nom d'expéditeur SMS se fait enregistrer, et cela
# prend des jours.
#
# Les écrire n'active rien : tant que `PAYMENT_GATEWAY` vaut `fake`, le pilote
# factice reste en place. C'est voulu — on ne bascule qu'une fois l'adaptateur
# écrit et éprouvé contre l'environnement de test du prestataire.

# ── Tranzak — encaissement Mobile Money (MTN, Orange)
#
# Documentation lue le 18 août 2026 : https://docs.developer.tranzak.me/
#   Production   https://dsapi.tranzak.me
#   Bac à sable  https://sandbox.dsapi.tranzak.me
#
# L'authentification se fait en deux temps : `POST /auth/token` avec `appId` et
# `appKey`, qui rend un `token` et son `expiresIn`. Le jeton se met en cache —
# leur documentation conseille les trois quarts de sa validité — puis voyage en
# `Authorization: Bearer`. En redemander un à chaque appel doublerait le nombre
# de requêtes sur la connexion la plus mauvaise du parcours.
#
# La clé porte un préfixe selon l'environnement : `SAND_` ou `PROD_`. S'en
# remettre à ce préfixe plutôt qu'à l'URL éviterait un jour de payer pour de vrai
# en croyant tester — les deux doivent concorder.
PAYMENT_GATEWAY=fake
TRANZAK_BASE_URL=https://sandbox.dsapi.tranzak.me
TRANZAK_APP_ID=
TRANZAK_APP_KEY=
# ⚠️ **À confirmer auprès de Tranzak avant d'écrire l'adaptateur.**
#
# Leur documentation mentionne un champ `authKey` dans la charge utile du
# webhook, qui « peut être utilisé pour vérifier que la charge provient bien de
# Tranzak », sans dire comment : ni en-tête de signature, ni algorithme, ni ce
# qui est signé. C'est précisément ce qu'il ne faut pas deviner — sans
# vérification correcte, quiconque connaît l'URL peut déclarer un paiement
# réussi, et le webhook crédite un chauffeur.
TRANZAK_WEBHOOK_SECRET=

# ── Tranzak — décaissement vers les agences et les chauffeurs
# Port distinct de l'encaissement : un prestataire peut couvrir l'un sans
# l'autre. Même identifiants si c'est le même compte.
PAYOUT_GATEWAY=fake
# Le compte source des virements, à confirmer auprès de Tranzak.
TRANZAK_PAYOUT_ACCOUNT=

# ── TechSoft — SMS
#
# L'OTP est le seul canal sans alternative (I8) : une panne ici bloque toute
# inscription.
#
# Documentation reçue le 18 août 2026 (export PDF de app.techsoft-sms.com) :
#   Base   https://app.techsoft-sms.com/api/http/
#   Jeton  obtenu dans « Mode développeurs », envoyé en en-tête, corps JSON
#
# ⚠️ **L'export ne couvre que l'API Contacts, pas l'envoi de SMS.** Il manque le
# chemin d'envoi, les champs attendus et le nom exact de l'en-tête
# d'authentification — le menu latéral masque le tiers gauche de chaque page.
# Reprendre depuis https://app.techsoft-sms.com/developers/http-docs, section SMS.
#
# À noter : leurs jetons sont limités par capacité (`view_contact` et
# consorts). Celui qu'on utilisera doit porter le droit d'envoi, sinon l'appel
# échouera sur une permission et non sur un problème de format.
SMS_DRIVER=log
TECHSOFT_BASE_URL=https://app.techsoft-sms.com/api/http
TECHSOFT_API_KEY=
# Le nom affiché à la réception. À faire enregistrer auprès de l'opérateur —
# c'est la démarche la plus longue de toute l'intégration.
TECHSOFT_SENDER_ID=
