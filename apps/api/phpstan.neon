includes:
    - vendor/larastan/larastan/extension.neon

    # Sans cette extension, PHPStan ignore que `assertNotNull()` et consorts
    # affinent un type : les tests se retrouvent truffés de `?->` défensifs qui
    # masquent les vraies nullités.
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    paths:
        - app
        - database
        - routes
        - tests

    # Niveau 8 dès le départ : le projet est vierge, il n'y a aucune dette à
    # absorber, et descendre d'un niveau est plus facile que d'en monter un
    # (§7 du standard de code).
    level: 8
