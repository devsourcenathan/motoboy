# React Native / Metro ne gère pas le node_modules isolé de pnpm : la
# résolution des modules natifs échoue de façon opaque. Expo documente
# node-linker=hoisted comme prérequis en monorepo pnpm.
#
# Coût assumé : on perd la stricte isolation des dépendances de pnpm, donc
# un package peut importer ce qu'il n'a pas déclaré. La règle « shared n'a
# aucune dépendance DOM ni React Native » (§6 du brief) doit donc être
# vérifiée en CI, pas par le résolveur.
node-linker=hoisted

# Évite que deux versions de React se retrouvent installées côté web.
strict-peer-dependencies=false
