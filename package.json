{
  "name": "motoboy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api:types": "pnpm --filter @motoboy/api-client generate",
    "check:shared": "node scripts/check-shared-purity.mjs",
    "brand": "node scripts/build-brand-assets.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm check:shared && pnpm lint && pnpm typecheck && pnpm test",
    "web": "pnpm --filter @motoboy/web dev",
    "mobile": "pnpm --filter @motoboy/mobile start",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "sharp": "^0.35.3"
  }
}
